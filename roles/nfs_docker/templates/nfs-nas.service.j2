# Ansible-managed by homelab-fleet. Do not edit.
[Unit]
Description=Validate and mount required NAS filesystems before Docker
After=network-online.target{% for unit in nfs_prerequisite_units %} {{ unit }}{% endfor %}

{% if nfs_prerequisite_units %}
Requires={{ nfs_prerequisite_units | join(" ") }}
{% endif %}
Wants=network-online.target
Before=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
{% for mount in nfs_boot_mounts %}
ExecStart=/usr/local/libexec/homelab-nfs-ensure {% if mount.check_only | default(false) %}--check-only {% endif %}{{ mount.source }} {{ mount.target }} {{ nfs_mount_options }}
{% endfor %}

[Install]
WantedBy=multi-user.target
