# Ansible-managed by homelab-fleet. Do not edit.
Match User {{ observer_user }}
    AuthenticationMethods publickey
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    PermitTTY no
    AllowTcpForwarding no
    AllowAgentForwarding no
    X11Forwarding no
    PermitTunnel no
    GatewayPorts no
    ForceCommand /opt/homelab-observer/venv/bin/homelab-diag-runner --config /etc/homelab-observer/runtime.json
