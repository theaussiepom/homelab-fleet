# Managed nonsecret settings; PSK bytes are externally provisioned, never rendered here.
ZBX_HOSTNAME={{ zabbix_agent_hostname }}
ZBX_SERVER_HOST={{ zabbix_agent_passive_server }}
{% if zabbix_agent_existing_project %}
ZBX_SERVER_PORT=10051
{% else %}
ZBX_ACTIVESERVERS={{ zabbix_agent_server_active }}
{% endif %}
ZBX_ACTIVE_ALLOW=true
ZBX_PASSIVE_ALLOW={{ 'true' if zabbix_agent_existing_project else 'false' }}
ZBX_TLSCONNECT={{ zabbix_agent_transport_mode }}
ZBX_TLSACCEPT={{ zabbix_agent_passive_tls_accept }}
{% if zabbix_agent_transport_mode == 'psk' %}
ZBX_TLSPSKIDENTITY={{ zabbix_agent_psk_identity }}
ZBX_TLSPSKFILE={{ zabbix_agent_psk_container_file }}
{% endif %}
